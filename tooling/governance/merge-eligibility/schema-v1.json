{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KARSIFT/vocanova-platform/tooling/governance/merge-eligibility/schema-v1.json",
  "title": "VocaNova merge-eligibility evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pull_request",
    "risk",
    "package",
    "checks",
    "roles",
    "risk_evidence",
    "ehr",
    "action_authority"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "head_sha", "author"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "author": { "type": "string", "minLength": 1 }
      }
    },
    "risk": { "enum": ["R0", "R1", "R2", "R3", "R4"] },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "automatic_merge_allowed"],
      "properties": {
        "path": { "type": "string", "pattern": "^specs/changes/VOC-[0-9]{3}-[a-z0-9-]+$" },
        "automatic_merge_allowed": { "type": "boolean" }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "observed"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "observed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "conclusion", "head_sha"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "status": { "type": "string" },
              "conclusion": { "type": ["string", "null"] },
              "head_sha": { "type": "string" }
            }
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["builder", "reviewer"],
      "properties": {
        "builder": { "$ref": "#/$defs/participant" },
        "reviewer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "role", "reviewed_sha", "verdict", "blocking_findings_resolved", "evidence_url"],
          "properties": {
            "identity": { "type": "string", "minLength": 1 },
            "role": { "type": "string", "minLength": 1 },
            "reviewed_sha": { "type": "string" },
            "verdict": { "const": "pass" },
            "blocking_findings_resolved": { "const": true },
            "evidence_url": {
              "type": "string",
              "pattern": "^https://github\\.com/KARSIFT/vocanova-platform/(pull|issues)/[0-9]+(#\\S+)?$"
            }
          }
        }
      }
    },
    "risk_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_record", "impact_assessment", "contingency_plan", "specialist_evidence", "deterministic_evidence"],
      "properties": {
        "decision_record": { "type": "boolean" },
        "impact_assessment": { "type": "boolean" },
        "contingency_plan": { "type": "boolean" },
        "specialist_evidence": { "type": "boolean" },
        "deterministic_evidence": { "type": "boolean" }
      }
    },
    "ehr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active"],
      "properties": { "active": { "type": "boolean" } }
    },
    "action_authority": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "required", "satisfied"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "satisfied": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "role"],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      }
    }
  }
}
