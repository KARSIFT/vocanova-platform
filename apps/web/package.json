{
  "name": "@vocanova/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start",
    "cloudflare:build": "opennextjs-cloudflare build && node scripts/check-worker-compatibility.mjs --canonicalize-opennext",
    "cloudflare:preview": "opennextjs-cloudflare preview",
    "cloudflare:preview:test": "node scripts/test-workerd.mjs",
    "cloudflare:typegen": "wrangler types worker-configuration.d.ts --env-interface CloudflareEnv",
    "cloudflare:typecheck": "wrangler types worker-configuration.d.ts --env-interface CloudflareEnv --check",
    "cloudflare:dry-run": "pnpm run cloudflare:dry-run:local && pnpm run cloudflare:dry-run:staging && pnpm run cloudflare:dry-run:production",
    "cloudflare:dry-run:local": "wrangler deploy --dry-run --experimental-provision=false --experimental-auto-create=false --env='' --outdir .wrangler/dry-run/local",
    "cloudflare:dry-run:production": "wrangler deploy --dry-run --experimental-provision=false --experimental-auto-create=false --env production --outdir .wrangler/dry-run/production",
    "cloudflare:dry-run:staging": "wrangler deploy --dry-run --experimental-provision=false --experimental-auto-create=false --env staging --outdir .wrangler/dry-run/staging",
    "cloudflare:limits": "node scripts/check-worker-limits.mjs",
    "cloudflare:compatibility": "node scripts/check-worker-compatibility.mjs",
    "test:sentry": "node --experimental-strip-types --test tests/workerd/reporting-seams.test.ts tests/workerd/worker-compatibility.test.mjs tests/workerd/workerd-smoke.test.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit --pretty false",
    "typecheck:e2e": "tsc -p tests/tsconfig.json --noEmit --pretty false",
    "test:e2e": "playwright test",
    "test:middleware": "node --import ./tests/middleware/extensionless-import-resolver.mjs --import ./tests/lib/next-headers-test-hook.mjs --test \"tests/middleware/*.test.ts\" \"tests/lib/*.test.ts\"",
    "test:lighthouse": "node tests/lighthouse/runner.mjs",
    "generate:tokens": "node scripts/generate-tokens-css.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@sentry/cloudflare": "10.69.0",
    "@sentry/react": "10.69.0",
    "@vocanova/api-client": "workspace:*",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@next/eslint-plugin-next": "16.3.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vocanova/design-tokens": "workspace:*",
    "axe-core": "4.13.0",
    "chrome-launcher": "1.2.1",
    "lighthouse": "13.4.1",
    "tailwindcss": "4.3.3",
    "wrangler": "4.125.0"
  }
}
