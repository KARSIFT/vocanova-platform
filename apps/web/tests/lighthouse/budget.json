{
  "$schema": "https://raw.githubusercontent.com/GoogleChrome/lighthouse-ci/main/docs/configuration.md",
  "_comment": "Performance budgets mirrored by tests/lighthouse/assertions.mjs. Update both files together and do not lower a threshold merely to hide a regression.",
  "version": 1,
  "budgets": [
    {
      "path": "/*",
      "resourceCounts": [
        { "resourceType": "third-party", "budget": 0 },
        { "resourceType": "total", "budget": 60 }
      ],
      "resourceSizes": [
        { "resourceType": "script", "budget": 250 },
        { "resourceType": "stylesheet", "budget": 50 },
        { "resourceType": "image", "budget": 100 },
        { "resourceType": "font", "budget": 100 },
        { "resourceType": "third-party", "budget": 0 },
        { "resourceType": "total", "budget": 500 }
      ],
      "timings": [
        { "metric": "first-contentful-paint", "budget": 2000 },
        { "metric": "largest-contentful-paint", "budget": 3000 },
        { "metric": "interactive", "budget": 4000 },
        { "metric": "total-blocking-time", "budget": 300 },
        { "metric": "cumulative-layout-shift", "budget": 0.1 },
        { "metric": "speed-index", "budget": 4000 }
      ],
      "scores": {
        "performance": 0.85,
        "accessibility": 0.95,
        "best-practices": 0.9
      }
    }
  ]
}
