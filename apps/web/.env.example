# apps/web/.env.example
#
# Reference for every environment variable the web app reads. Copy
# this file to a real `.env.local` for `next dev`/`next start` and fill in
# local values. Staging and production values are supplied through held,
# environment-scoped Cloudflare configuration in a later VOC-080 task.
#
# This file is the single source of truth for which env vars the
# web app expects: apps/web/src/lib/env.ts is the matching reader,
# and VOC-032-TEST-05 diffs the env names declared here against
# the names that reader actually consumes.
#
# Conventions:
#   * No real credential is committed. Every value below is a
#     placeholder, an obvious fake, or an explicit "unset" sentinel.
#   * NEXT_PUBLIC_* vars are inlined into the client bundle at
#     build time. They are NOT runtime-overridable in production:
#     the held build/promotion job must provide the matching public API URL.
#   * Vars without the NEXT_PUBLIC_ prefix are server-only and
#     read at request time.

# -----------------------------------------------------------------------------
# API base URL
# -----------------------------------------------------------------------------

# [server-only, local/transition fallback] Server Components and middleware
# prefer the typed `API` service binding under OpenNext/workerd. This URL keeps
# `next dev`, `next start`, and the legacy parity harness usable when a binding
# is not present. It falls back to NEXT_PUBLIC_API_BASE_URL and then the
# canonical loopback API origin below.
API_BASE_URL=http://127.0.0.1:8080

# [build-time, client+server] Base URL the browser bundle uses to
# reach the API, and the server-side fallback when API_BASE_URL
# is unset. Next.js inlines NEXT_PUBLIC_* values at build time, so
# the held Cloudflare build must provide the correct public API URL. For local
# development, use the locally running API. No current workflow supplies a
# staging/production value or deploys the Worker.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080

# [build-time, client+server] Optional Sentry DSN for browser/server error
# reporting from apps/web. Leave unset to disable Sentry entirely for the web
# app.
NEXT_PUBLIC_SENTRY_DSN=

# [build-time, client+server] Optional environment/release tags attached to
# apps/web Sentry events when NEXT_PUBLIC_SENTRY_DSN is set.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
NEXT_PUBLIC_SENTRY_RELEASE=sha-localdev
