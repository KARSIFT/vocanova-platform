{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vocanova-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vocanova-local",
      "database_id": "local",
      "migrations_dir": "migrations",
      "migrations_table": "d1_migrations",
    },
  ],
  "vars": {
    "ENVIRONMENT": "local",
    "RELEASE": "local",
    "CORS_ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000",
    "AUTH_BASE_URL": "http://localhost:3000",
    "OAUTH_REDIRECT_URI": "http://localhost:8787/api/v1/auth/oauth/google/callback",
    "OAUTH_RETURN_ALLOWLIST": "http://localhost:3000/home,http://localhost:3000/onboarding",
    "MAGIC_LINK_ENABLED": "true",
    "GOOGLE_OAUTH_ENABLED": "false",
    "NEW_USER_SIGNUP_ENABLED": "true",
    "NEW_USER_SIGNUP_ALLOWLIST": "",
    "RESERVED_SYNTHETIC_EMAIL": "",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
