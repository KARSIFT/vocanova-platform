{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vocanova-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vocanova-local",
      "database_id": "local",
      "migrations_dir": "migrations",
      "migrations_table": "d1_migrations",
    },
  ],
  "vars": {
    "ENVIRONMENT": "local",
    "RELEASE": "local",
    "CORS_ALLOWED_ORIGINS": "http://127.0.0.1:3000",
    "AUTH_BASE_URL": "http://127.0.0.1:3000",
    "OAUTH_REDIRECT_URI": "http://127.0.0.1:8080/api/v1/auth/oauth/google/callback",
    "OAUTH_RETURN_ALLOWLIST": "http://127.0.0.1:3000/home,http://127.0.0.1:3000/onboarding",
    "MAGIC_LINK_ENABLED": "true",
    "GOOGLE_OAUTH_ENABLED": "false",
    "NEW_USER_SIGNUP_ENABLED": "true",
    "NEW_USER_SIGNUP_ALLOWLIST": "",
    "RESERVED_SYNTHETIC_EMAIL": "",
    "AI_GENERATION_ENABLED": "false",
    "AI_PER_MINUTE": "5",
    "AI_PER_DAY": "30",
    "AI_GLOBAL_PER_DAY": "1000",
    "AI_MONTHLY_COST_HARD_STOP_CENTS": "0",
    "AI_REQUEST_COST_CENTS": "0",
    "AI_GENERATION_LEASE_SECONDS": "15",
    "AI_PROVIDER_TIMEOUT_MS": "10000",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "env": {
    "staging": {
      "name": "vocanova-api-staging",
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vocanova-staging",
          "database_id": "held-staging-d1",
          "migrations_dir": "migrations",
          "migrations_table": "d1_migrations",
        },
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "RELEASE": "held",
        "CORS_ALLOWED_ORIGINS": "https://web-staging.invalid",
        "AUTH_BASE_URL": "https://web-staging.invalid",
        "OAUTH_REDIRECT_URI": "https://api-staging.invalid/api/v1/auth/oauth/google/callback",
        "OAUTH_RETURN_ALLOWLIST": "https://web-staging.invalid/home,https://web-staging.invalid/onboarding",
        "MAGIC_LINK_ENABLED": "false",
        "GOOGLE_OAUTH_ENABLED": "false",
        "NEW_USER_SIGNUP_ENABLED": "false",
        "NEW_USER_SIGNUP_ALLOWLIST": "",
        "RESERVED_SYNTHETIC_EMAIL": "",
        "AI_GENERATION_ENABLED": "false",
        "AI_PER_MINUTE": "5",
        "AI_PER_DAY": "30",
        "AI_GLOBAL_PER_DAY": "1000",
        "AI_MONTHLY_COST_HARD_STOP_CENTS": "0",
        "AI_REQUEST_COST_CENTS": "0",
        "AI_GENERATION_LEASE_SECONDS": "15",
        "AI_PROVIDER_TIMEOUT_MS": "10000",
      },
    },
    "production": {
      "name": "vocanova-api-production",
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vocanova-production",
          "database_id": "held-production-d1",
          "migrations_dir": "migrations",
          "migrations_table": "d1_migrations",
        },
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "RELEASE": "held",
        "CORS_ALLOWED_ORIGINS": "https://web-production.invalid",
        "AUTH_BASE_URL": "https://web-production.invalid",
        "OAUTH_REDIRECT_URI": "https://api-production.invalid/api/v1/auth/oauth/google/callback",
        "OAUTH_RETURN_ALLOWLIST": "https://web-production.invalid/home,https://web-production.invalid/onboarding",
        "MAGIC_LINK_ENABLED": "false",
        "GOOGLE_OAUTH_ENABLED": "false",
        "NEW_USER_SIGNUP_ENABLED": "false",
        "NEW_USER_SIGNUP_ALLOWLIST": "",
        "RESERVED_SYNTHETIC_EMAIL": "",
        "AI_GENERATION_ENABLED": "false",
        "AI_PER_MINUTE": "5",
        "AI_PER_DAY": "30",
        "AI_GLOBAL_PER_DAY": "1000",
        "AI_MONTHLY_COST_HARD_STOP_CENTS": "0",
        "AI_REQUEST_COST_CENTS": "0",
        "AI_GENERATION_LEASE_SECONDS": "15",
        "AI_PROVIDER_TIMEOUT_MS": "10000",
      },
    },
  },
}
