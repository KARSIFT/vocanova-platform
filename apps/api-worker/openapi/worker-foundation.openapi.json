{
  "components": {
    "parameters": {},
    "schemas": {
      "Health": {
        "properties": {
          "database": {
            "enum": [
              "ok",
              "unhealthy"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "unhealthy"
            ],
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database",
          "timestamp"
        ],
        "type": "object"
      },
      "Problem": {
        "properties": {
          "detail": {
            "type": "string"
          },
          "requestId": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "enum": [
              "about:blank"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "requestId"
        ],
        "type": "object"
      },
      "RuntimeConfig": {
        "properties": {
          "data": {
            "enum": [
              "d1"
            ],
            "type": "string"
          },
          "environment": {
            "enum": [
              "local",
              "staging",
              "production"
            ],
            "type": "string"
          },
          "migrationStatus": {
            "enum": [
              "identity-account-parity"
            ],
            "type": "string"
          },
          "release": {
            "type": "string"
          },
          "runtime": {
            "enum": [
              "cloudflare-workers"
            ],
            "type": "string"
          }
        },
        "required": [
          "environment",
          "release",
          "runtime",
          "data",
          "migrationStatus"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Operational Worker/D1 migration target. Identity and account endpoints have parity evidence; the Go OpenAPI document remains canonical until every domain passes.",
    "title": "VocaNova Worker API migration target",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/account-deletion-requests": {
      "post": {
        "operationId": "CreateAccountDeletionRequest",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "idempotencyKey": {
                      "type": "string"
                    },
                    "purgeAfter": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "replayed": {
                      "type": "boolean"
                    },
                    "requestedAt": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "deactivated"
                      ],
                      "type": "string"
                    },
                    "userId": {
                      "format": "uuid",
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "userId",
                    "requestedAt",
                    "purgeAfter",
                    "idempotencyKey",
                    "replayed"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "tags": [
          "Identity and account"
        ]
      }
    },
