{
  "components": {
    "parameters": {},
    "schemas": {
      "Health": {
        "properties": {
          "database": {
            "enum": [
              "ok",
              "unhealthy"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "unhealthy"
            ],
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database",
          "timestamp"
        ],
        "type": "object"
      },
      "Problem": {
        "properties": {
          "detail": {
            "type": "string"
          },
          "requestId": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "enum": [
              "about:blank"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "requestId"
        ],
        "type": "object"
      },
      "RuntimeConfig": {
        "properties": {
          "data": {
            "enum": [
              "d1"
            ],
            "type": "string"
          },
          "environment": {
            "enum": [
              "local",
              "staging",
              "production"
            ],
            "type": "string"
          },
          "migrationStatus": {
            "enum": [
              "foundation"
            ],
            "type": "string"
          },
          "release": {
            "type": "string"
          },
          "runtime": {
            "enum": [
              "cloudflare-workers"
            ],
            "type": "string"
          }
        },
        "required": [
          "environment",
          "release",
          "runtime",
          "data",
          "migrationStatus"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Operational Worker/D1 foundation. The Go OpenAPI document remains the canonical /api/v1 migration contract until endpoint parity is complete.",
    "title": "VocaNova Worker API foundation",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/configz": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeConfig"
                }
              }
            },
            "description": "Safe runtime configuration"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Runtime configuration is invalid"
          }
        },
        "summary": "Non-secret runtime configuration",
        "tags": [
          "Operations"
        ]
      }
    },
    "/healthz": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Worker and D1 are reachable"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "D1 is unreachable"
          }
        },
        "summary": "Liveness and D1 reachability probe",
        "tags": [
          "Operations"
        ]
      }
    }
  },
  "webhooks": {}
}
